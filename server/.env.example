GOOGLE_CLOUD_PROJECT=evictwise
PORT=3001
CLIENT_ORIGIN=http://localhost:8081
# Accounts default to server/private/accounts.sqlite3 (ignored by Git).
# AUTH_DATABASE_PATH=/absolute/private/path/accounts.sqlite3
# Production requires HTTPS. Configure a trusted proxy only when deployed behind one.
# NODE_ENV=production
# TRUST_PROXY_HOPS=1
# RAG embeddings and chat (server-only key).
GEMINI_API_KEY=
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_CHAT_MODEL=gemini-3.5-flash

# Transient chat failures retry the primary once, then try the fallback once.
# Each chat attempt has a 30-second limit. Quota errors skip the primary retry.
# An empty value disables the fallback.
RAG_CHAT_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional absolute paths for deployments/worktrees.
# RAG_DATABASE_PATH=/absolute/private/legal-index-gemini.sqlite3
# RAG_KNOWLEDGE_PATH=/absolute/legal_knowlege

# Document transcription, deadline extraction, and case summaries (server only).
OPENAI_API_KEY=

# Optional separate key-file location for the OFFLINE synthetic matching demo.
# File contains 32 random bytes; never use EXPO_PUBLIC_* for this key.
# MATCHING_DEMO_KEY_PATH=/absolute/private/matching-demo.key
